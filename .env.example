# Server-only model credentials. Never expose these through VITE_* variables.
ARK_API_KEY=
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
ARK_TIMEOUT_MS=90000
ARK_MAX_RETRIES=0
ARK_TEMPERATURE=0
ARK_FRAME_TIMEOUT_SECONDS=20
ARK_ROUTER_MODEL=doubao-seed-2-0-lite-260428
CHAIN1_PYTHON=python3
ARK_ROUTER_TIMEOUT_MS=45000
ARK_ROUTER_MAX_RETRIES=0

DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_MODEL=wan2.7-image-pro
DASHSCOPE_IMAGE_TIMEOUT_MS=180000
DASHSCOPE_IMAGE_MAX_RETRIES=2
AGNES_CHAT_ENDPOINT=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_CHAT_MODEL=agnes-2.0-flash
AGNES_CHAT_TIMEOUT_SECONDS=180
AGNES_CHAT_MAX_TOKENS=4096
AGNES_CHAT_MAX_RETRIES=2

# Cost-efficient test limits. Raise these only for final-quality validation.
CHAIN1_ALLOW_SECONDARY_ROUTE=false
CHAIN1_IMAGE_MAX_ATTEMPTS=1
CHAIN1_HINT_STICKER_ENABLED=true
CHAIN1_HINT_STICKER_MAX_ATTEMPTS=1
CHAIN2_MAX_SEMANTIC_SEGMENTS_PER_REQUEST=16
CHAIN2_QA_BATCH_SIZE=4
CHAIN2_PROVIDER=doubao

VIDEO_ASR_PROVIDER=faster_whisper
VIDEO_ASR_MODEL_SIZE=small
DOUYIN_COOKIES_PATH=
VIDEO_ASR_DEVICE=cpu
VIDEO_ASR_COMPUTE_TYPE=int8
VIDEO_ASR_BEAM_SIZE=5
VIDEO_ASR_CONDITION_ON_PREVIOUS_TEXT=false
VIDEO_ASR_INITIAL_PROMPT=请输出准确的简体中文口播文案，保留数字、金额和专有名词。
VIDEO_ASR_WORD_TIMESTAMPS=true
VIDEO_ASR_MAX_SEGMENT_SECONDS=8
VIDEO_ASR_MAX_SEGMENT_CHARS=50
VIDEO_FUNASR_MODEL=paraformer-zh
VIDEO_FUNASR_VAD_MODEL=fsmn-vad
VIDEO_FUNASR_PUNC_MODEL=ct-punc
VIDEO_FUNASR_BATCH_SIZE_SECONDS=60
VIDEO_FUNASR_HOTWORDS=
VIDEO_OCR_ENABLED=true
VIDEO_OCR_FRAMES_PER_CHUNK=8
VIDEO_OCR_PERIODIC_SECONDS=60
VIDEO_ANALYSIS_CHUNK_SECONDS=240
VIDEO_ANALYSIS_CHUNK_OVERLAP_SECONDS=12

BACKEND_DATA_DIR=backend_data/jobs
BACKEND_SHOWCASE_FILE=backend_data/showcase.json
BACKEND_KNOWLEDGE_POOL_FILE=backend_data/knowledge-pool.json
BACKEND_CHAIN3_URL=http://127.0.0.1:8787
BACKEND_CHAIN3_TIMEOUT_SECONDS=30

# 链路3服务端文本模型。默认复用 ARK_API_KEY 与 DOUBAO_MODEL。
CHAIN3_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAIN3_ENV_FILE=
PLAYBACK_TRANSCODE_TIMEOUT_SECONDS=7200
MAX_UPLOAD_BYTES=524288000
