# Server-only model credentials. Never expose these through VITE_* variables.
ARK_API_KEY=
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
ARK_TIMEOUT_MS=180000
ARK_MAX_RETRIES=2
ARK_FRAME_TIMEOUT_SECONDS=20
ARK_ROUTER_MODEL=doubao-seed-2-0-lite-260428
ARK_ROUTER_TIMEOUT_MS=90000
ARK_ROUTER_MAX_RETRIES=1

AGNES_API_KEY=
AGNES_IMAGE_ENDPOINT=https://apihub.agnes-ai.com/v1/images/generations
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_TIMEOUT_MS=180000
AGNES_IMAGE_MAX_RETRIES=2

VIDEO_ASR_MODEL_SIZE=base
VIDEO_ASR_DEVICE=cpu
VIDEO_ASR_COMPUTE_TYPE=int8
VIDEO_ASR_BEAM_SIZE=5
VIDEO_ASR_CONDITION_ON_PREVIOUS_TEXT=false
VIDEO_ASR_INITIAL_PROMPT=请输出准确的简体中文口播文案，保留数字、金额和专有名词。
VIDEO_ASR_WORD_TIMESTAMPS=true
VIDEO_ASR_MAX_SEGMENT_SECONDS=8
VIDEO_ASR_MAX_SEGMENT_CHARS=50
VIDEO_OCR_ENABLED=true
VIDEO_OCR_FRAMES_PER_CHUNK=8
VIDEO_OCR_PERIODIC_SECONDS=60
VIDEO_ANALYSIS_CHUNK_SECONDS=240
VIDEO_ANALYSIS_CHUNK_OVERLAP_SECONDS=12

BACKEND_DATA_DIR=backend_data/jobs
MAX_UPLOAD_BYTES=524288000
