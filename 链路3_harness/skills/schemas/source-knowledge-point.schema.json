{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceKnowledgePoint",
  "type": "object",
  "required": [
    "source_knowledge_id",
    "title",
    "statement",
    "knowledge_type",
    "knowledge_dimension",
    "structural_role",
    "source_video_id",
    "creator_id",
    "start_ms",
    "end_ms",
    "evidence_text",
    "confidence"
  ],
  "properties": {
    "source_knowledge_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "knowledge_type": {
      "enum": [
        "concept",
        "fact",
        "mechanism",
        "process",
        "event",
        "rule",
        "method",
        "claim",
        "comparison",
        "example",
        "evidence"
      ]
    },
    "knowledge_dimension": {
      "enum": [
        "definition",
        "property",
        "cause",
        "mechanism",
        "process",
        "effect",
        "comparison",
        "condition",
        "method",
        "application",
        "example",
        "evidence",
        "chronology",
        "misconception_correction"
      ]
    },
    "structural_role": {
      "enum": [
        "core",
        "prerequisite",
        "extension",
        "example",
        "transition"
      ]
    },
    "topic": {
      "type": "string"
    },
    "subtopic": {
      "type": [
        "string",
        "null"
      ]
    },
    "intrinsic_difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source_emphasis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source_video_id": {
      "type": "string",
      "minLength": 1
    },
    "creator_id": {
      "type": "string",
      "minLength": 1
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "supporting_spans": {
      "type": "array"
    },
    "evidence_text": {
      "type": "string",
      "minLength": 1
    },
    "evidence_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "checks": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
