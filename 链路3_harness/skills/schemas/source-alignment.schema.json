{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceAlignment",
  "type": "object",
  "required": [
    "alignment_id",
    "canonical_node_id",
    "alignment_type",
    "reason",
    "confidence"
  ],
  "properties": {
    "alignment_id": {
      "type": "string"
    },
    "canonical_node_id": {
      "type": "string"
    },
    "alignment_type": {
      "enum": [
        "consensus",
        "perspective_complement",
        "condition_difference",
        "conflict",
        "insufficient_evidence"
      ]
    },
    "shared_proposition": {
      "type": "string"
    },
    "source_positions": {
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": true
}
