{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningPath",
  "type": "object",
  "required": [
    "path_id",
    "title",
    "goal",
    "template",
    "stages"
  ],
  "properties": {
    "path_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "enum": [
        "timeline_path",
        "difficulty_path",
        "scenario_path",
        "chapter_path",
        "viewpoint_comparison",
        "time_plan",
        "default_stage_path"
      ]
    },
    "estimated_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "coverage_note": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "title",
          "goal",
          "reason",
          "knowledge_nodes"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "canonical_node_id",
                "display_title",
                "learning_goal",
                "reason_for_placement",
                "recommended_source"
              ],
              "properties": {
                "canonical_node_id": {
                  "type": "string"
                },
                "display_title": {
                  "type": "string"
                },
                "learning_goal": {
                  "type": "string"
                },
                "reason_for_placement": {
                  "type": "string"
                },
                "recommended_source": {
                  "type": "object",
                  "required": [
                    "video_id",
                    "source_knowledge_id",
                    "start_ms",
                    "end_ms"
                  ],
                  "properties": {
                    "video_id": {
                      "type": "string"
                    },
                    "source_knowledge_id": {
                      "type": "string"
                    },
                    "start_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "selection_reason": {
                      "type": "string"
                    }
                  }
                },
                "alternative_sources": {
                  "type": "array"
                },
                "estimated_minutes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "excluded_summary": {
      "type": "array"
    },
    "missing_prerequisites": {
      "type": "array"
    },
    "uncovered_user_requirements": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
