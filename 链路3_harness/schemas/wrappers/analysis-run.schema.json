{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisRun",
  "type": "object",
  "required": [
    "analysis_id",
    "status",
    "created_at",
    "updated_at",
    "request",
    "progress"
  ],
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "request": {
      "type": "object"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "result": {},
    "error": {}
  }
}
