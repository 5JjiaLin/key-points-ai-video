{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalKnowledgeNode",
  "type": "object",
  "required": [
    "canonical_node_id",
    "canonical_title",
    "canonical_statement",
    "knowledge_type",
    "knowledge_dimension",
    "source_knowledge_ids",
    "source_video_ids",
    "support_strength",
    "merge_confidence"
  ],
  "properties": {
    "canonical_node_id": {
      "type": "string"
    },
    "canonical_title": {
      "type": "string",
      "minLength": 1
    },
    "canonical_statement": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_type": {
      "type": "string"
    },
    "knowledge_dimension": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "subtopic": {
      "type": [
        "string",
        "null"
      ]
    },
    "intrinsic_difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source_knowledge_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_video_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "original_expressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "support_strength": {
      "enum": [
        "single_source",
        "multi_source"
      ]
    },
    "merge_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "canonicalization_reason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
