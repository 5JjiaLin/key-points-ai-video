# 服务端专用。不要使用 VITE_*、NEXT_PUBLIC_* 等公开变量。
AGNES_API_KEY=replace_with_rotated_server_key
AGNES_IMAGE_ENDPOINT=https://apihub.agnes-ai.com/v1/images/generations
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_TIMEOUT_MS=180000
AGNES_IMAGE_MAX_RETRIES=2
CHAIN1_TRACE_DIR=.harness/traces
CHAIN1_ASSET_DIR=public/generated/chain1-cards
