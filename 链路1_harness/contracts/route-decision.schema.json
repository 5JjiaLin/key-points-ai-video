{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteDecision",
  "type": "object",
  "required": ["is_candidate", "primary_route", "route_scores", "confidence", "reason", "evidence"],
  "properties": {
    "is_candidate": { "type": "boolean" },
    "primary_route": {
      "enum": ["abstract_to_intuitive", "knowledge_gap", "claim_verification", "discard"]
    },
    "secondary_route": {
      "type": ["string", "null"],
      "enum": ["abstract_to_intuitive", "knowledge_gap", "claim_verification", null]
    },
    "route_scores": {
      "type": "object",
      "required": ["abstract_to_intuitive", "knowledge_gap", "claim_verification", "discard"],
      "additionalProperties": false,
      "properties": {
        "abstract_to_intuitive": { "type": "number", "minimum": 0, "maximum": 1 },
        "knowledge_gap": { "type": "number", "minimum": 0, "maximum": 1 },
        "claim_verification": { "type": "number", "minimum": 0, "maximum": 1 },
        "discard": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
