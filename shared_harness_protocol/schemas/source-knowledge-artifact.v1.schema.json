{
  "$id": "source-knowledge-artifact.v1.schema.json",
  "title": "SourceKnowledgeArtifactV1",
  "type": "object",
  "required": ["schema_version", "artifact_id", "video_id", "environment", "producer", "created_at", "knowledge_points"],
  "properties": {
    "schema_version": {"const": "source-knowledge-artifact.v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "required": ["schema_version", "sha256"],
      "properties": {
        "schema_version": {"const": "video-environment.v1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "producer": {"type": "object"},
    "created_at": {"type": "string"},
    "knowledge_points": {"type": "array", "minItems": 1}
  }
}
